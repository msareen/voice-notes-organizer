{
  // The CLI + server project. The browser modules under src/web/assets are a
  // separate project (their own tsconfig.json there) because they need DOM
  // globals and must not see Bun's.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun"]
  },
  "include": ["bin/**/*.ts", "src/**/*.ts"],
  "exclude": ["src/web/assets/**", "node_modules"]
}
